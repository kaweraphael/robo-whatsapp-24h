# Copie este arquivo pra ".env" e preencha. O .env NUNCA vai pro GitHub.
# O Claude Code preenche junto com você: abra a pasta e diga "configura pra mim".

# ---------- Meta (WhatsApp oficial) — veja docs/02-meta-passo-a-passo.md
META_TOKEN=                 # token PERMANENTE do usuário do sistema (começa com EAA)
META_APP_SECRET=            # Configurações do app > Básico > Chave secreta do app
META_VERIFY_TOKEN=          # você inventa (o Claude gera um aleatório)
META_PHONE_NUMBER_ID=       # ID do número (não é o telefone!)
META_WABA_ID=               # ID da conta do WhatsApp Business

# ---------- IA — preencha só a do provedor escolhido em config/robo.json
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
IA_API_KEY=                 # provedor "compativel" (Groq, DeepSeek, Ollama...)
IA_BASE_URL=                # ex.: https://api.groq.com/openai/v1

# ---------- Painel
PAINEL_SENHA=               # senha do /painel (o Claude gera uma forte)

# ---------- Preenchido sozinho depois de publicar
ROBO_URL=                   # endereço público do robô (ex.: https://robo.seunome.workers.dev)
ROBO_NOME=robo-whatsapp     # nome do projeto na Cloudflare
